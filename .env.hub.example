DB_USER=interchange-hub
DB_PASSWORD=hub-dev-password
# DB_SSL=true             # enable SSL for the database connection
# DB_STATEMENT_TIMEOUT_MS=60000 # positive integer; cancels SQL exceeding this duration

BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3000

# Encrypts credential secrets at rest. Required: the hub refuses to start
# without it. 32 bytes, hex -- generate with `openssl rand -hex 32`.
CREDENTIAL_ENCRYPTION_KEY=

# Seals per-principal signing keys at rest. Required: the hub refuses to
# start without it. A SEPARATE key from CREDENTIAL_ENCRYPTION_KEY so the two
# rotate independently. 32 bytes, hex -- generate with `openssl rand -hex 32`.
PRINCIPAL_KEY_ENCRYPTION_KEY=

HUB_DATA_DIR=./tmp/hub-data
# PORT=3000               # override the default hub port

# Per-tarball cap (bytes) for tool packages uploaded to the package
# registry. Defaults to 10 MiB (10485760) when unset; must be a
# positive number.
# HUB_MAX_TARBALL_BYTES=10485760

# Custom inference adapters every provisioned sidecar must load. JSON array
# of { provider, specifier, export } entries; forwarded verbatim to each
# spawned sidecar, whose adapter registry validates the entries and admits
# `model_provider.plugin` values at deploy time. Leave unset when no custom
# adapters are declared.
# SIDECAR_ADAPTER_MANIFEST=[{"provider":"openai-responses","specifier":"@corbits/openai-responses","export":"createAdapter"}]

# PG_SCHEMA pins the hub to a specific postgres schema. Set only by the
# integration-test harness so each spawned hub gets a dedicated,
# droppable schema; leave unset for normal operation.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
