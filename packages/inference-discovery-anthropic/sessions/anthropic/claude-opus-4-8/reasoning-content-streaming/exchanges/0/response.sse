event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"s $1.00 more, so bat = $x + 1.00$\n\n## Writing the Equation\n\nTogether they cost $1.10:\n\n$$x + (x + 1.00) = 1.10$$\n\n## Solving\n\n$$2x + 1.00 = 1"}     }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":".10$$\n\n$$2x = 0.10$$\n\n$$x = 0.05$$\n\n## Verification\n\n- Ball = **$0.05**\n- Bat = $0.05 + $1.00 = **$1.05**\n- Total: $0.05 + $1.05 = **$1"}}

