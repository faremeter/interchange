      "code": "# Correct computation of the 12th Fibonacci number (showing both common index conventions)\r\n\r\ndef fib_zero_indexed(n):\r\n    # F0 = 0, F1 = 1\r\n    a, b = 0, 1\r\n    for _ in range(n):\r\n        a, b = b, a + b\r\n    return a  # after n steps, 'a' is F_n (zero-indexed)\r\n\r\ndef fib_one_indexed(n):\r\n    # F1 = 1, F2 = 1\r\n    # This is the same as zero-indexed F_n for n >= 1\r\n    return fib_zero_indexed(n)\r\n\r\nn = 12\r\nprint(f\"Using zero-indexed (F0=0): F_{n} = {fib_zero_indexed(n)}\")\r\nprint(f\"Using one-indexed (F1=1): F_{n} = {fib_one_indexed(n)}\")",
