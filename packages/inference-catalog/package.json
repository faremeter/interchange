{
  "name": "@intx/inference-catalog",
  "description": "Declarative, dependency-free catalog of inference models, providers, and their offering capabilities and quirks",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "intx-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "intx-src": "./src/models.ts",
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@intx/inference": "workspace:*",
    "@intx/inference-discovery": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
