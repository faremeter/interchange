{
  "name": "@intx/workflow-host",
  "description": "Production-host implementations of the abstract WorkflowRuntimeEnv from @intx/workflow",
  "version": "0.4.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "intx-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "intx-src": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./deploy": {
      "intx-src": "./src/deploy/index.ts",
      "types": "./dist/deploy/index.d.ts",
      "default": "./dist/deploy/index.js"
    },
    "./child": {
      "intx-src": "./src/child/program.ts",
      "types": "./dist/child/program.d.ts",
      "default": "./dist/child/program.js"
    },
    "./probe": {
      "intx-src": "./src/probe/index.ts",
      "types": "./dist/probe/index.d.ts",
      "default": "./dist/probe/index.js"
    },
    "./probe/child": {
      "intx-src": "./src/probe/child.ts",
      "types": "./dist/probe/child.d.ts",
      "default": "./dist/probe/child.js"
    }
  },
  "dependencies": {
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/harness": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/mail-memory": "workspace:*",
    "@intx/mailbox": "workspace:*",
    "@intx/mime": "workspace:*",
    "@intx/storage-isogit": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "arktype": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
