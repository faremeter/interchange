data: {"candidates": [{"content": {"parts": [{"executableCode": {"language": "PYTHON","code": "def fibonacci(n):\n    if n \u003c= 0: return 0\n    elif n == 1: return 1\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b\n\nprint(\"The 12th Fibonacci number is:\", fibonacci(12))","id": "4z37uru6"},"thoughtSignature": ""}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 13,"candidatesTokenCount": 99,"totalTokenCount": 516,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 13}],"thoughtsTokenCount": 404,"serviceTier": "standard"},"modelVersion": "gemini-3.1-pro-preview","responseId": "X1p3atPcDMeHz7IPybzxiQQ"}

